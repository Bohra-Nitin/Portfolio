<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Module 2 Activity 1</title><style>
:root{--bg:#07111f;--panel:#101d31;--panel2:#172944;--text:#f6f8fb;--muted:#aeb9c9;--cyan:#40d6e8;--green:#74df93;--red:#f2747c;--orange:#ffc25b;--line:#2c4263}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at top,#18375e 0,#07111f 58%);color:var(--text);font-family:Arial,sans-serif;min-height:100vh}
.wrap{max-width:980px;margin:auto;padding:18px}.top{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}.brand{font-weight:800}.brand b{color:var(--cyan)}.pill{background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:8px 12px}
.progress{height:9px;background:#0c1829;border-radius:99px;overflow:hidden;margin:14px 0 22px}.bar{height:100%;width:0;background:linear-gradient(90deg,var(--cyan),var(--green));transition:width .25s}
.screen{display:none}.screen.active{display:block}h1{font-size:56px;line-height:1.02}h2{font-size:31px}.accent{color:var(--cyan)}.sub{color:var(--muted);line-height:1.5;font-size:17px}.hero{text-align:center;padding:42px 12px}.tag{display:inline-block;padding:6px 10px;border:1px solid var(--line);border-radius:99px;color:var(--muted);font-size:13px}
.scenario{background:linear-gradient(145deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:18px;padding:19px;margin:15px 0}.scenario strong{color:var(--orange)}
.options{display:grid;gap:10px;margin:16px 0}.opt{padding:14px;border-radius:13px;text-align:left;background:#0c1829;border:1px solid var(--line);color:var(--text);font-size:16px;cursor:pointer}.opt:hover{border-color:var(--cyan)}.opt:disabled{cursor:default}.good{border-color:var(--green)!important;background:rgba(116,223,147,.12)!important}.bad{border-color:var(--red)!important;background:rgba(242,116,124,.10)!important}
.feedback{display:none;margin-top:12px;background:#0d192b;border-left:5px solid var(--cyan);padding:14px;border-radius:11px;line-height:1.5}.feedback.show{display:block}.feedback.ok{border-left-color:var(--green)}.feedback.no{border-left-color:var(--red)}
.btn{border:0;border-radius:13px;padding:13px 20px;font-weight:800;font-size:16px;cursor:pointer;background:var(--cyan);color:#041017}.btn.next{display:none}.btn.next.show{display:inline-block}.row{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-top:18px}.small{font-size:13px;color:var(--muted)}
.dragbank{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px;margin:16px 0}.drag{padding:13px;background:#0c1829;border:1px solid var(--line);border-radius:13px;cursor:grab}
.dropgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.dropzone{min-height:135px;border:2px dashed #405574;border-radius:16px;padding:14px;background:rgba(12,24,41,.55)}.dropzone.over{border-color:var(--cyan)}
.circular{width:min(530px,90vw);height:min(530px,90vw);margin:22px auto;position:relative;border:4px solid #3c5578;border-radius:50%;background:radial-gradient(circle,#10243b 0 29%,transparent 30%),#0b1728}
.center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:145px;height:145px;border-radius:50%;border:2px solid var(--cyan);display:flex;align-items:center;justify-content:center;text-align:center;background:#0d1a2b;font-weight:800}
.sector{position:absolute;width:108px;min-height:72px;padding:8px;text-align:center;border:2px dashed #536987;border-radius:12px;background:#101d31;font-size:13px}.n{position:absolute;top:-24px;left:50%;transform:translateX(-50%);width:30px;height:30px;border-radius:50%;background:var(--orange);color:#111b27;font-weight:900;display:flex;align-items:center;justify-content:center}
.s1{left:calc(50% - 54px);top:8px}.s2{right:15px;top:calc(50% - 36px)}.s3{right:38px;bottom:24px}.s4{left:calc(50% - 54px);bottom:8px}.s5{left:15px;top:calc(50% - 36px)}
@media(max-width:700px){.dropgrid{grid-template-columns:1fr}.circular{width:340px;height:340px}.sector{width:82px;font-size:11px}.center{width:105px;height:105px;font-size:12px}.s1,.s4{left:calc(50% - 41px)}.s2{right:2px}.s3{right:10px}.s5{left:2px}}
</style></head><body><div class='wrap'><div class='top'><div class='brand'><b>EPICS</b> • Design Thinking Basics</div><div class='pill'>⭐ Score: <span id='score'>0</span></div></div><div class='progress'><div class='bar' id='bar'></div></div><section class="screen active" id="s0"><div class="hero"><span class="tag">MODULE 2 • ~20 MINUTES</span><h1>Design Thinking Basics</h1><p class="sub">Learn the five stages and what each stage is supposed to achieve.</p><button class="btn" onclick="go(1)">START →</button></div></section><section class="screen" id="s1"><h2>Question 1</h2><p class="sub">Which stage focuses on understanding people and context?</p><div class="options"><button class="opt" onclick="mc(1,this,true,'Empathize is the stage used to understand experiences and context.','n1')">A. Empathize</button><button class="opt" onclick="mc(1,this,false,'Empathize is the stage used to understand experiences and context.','n1')">B. Define</button><button class="opt" onclick="mc(1,this,false,'Empathize is the stage used to understand experiences and context.','n1')">C. Ideate</button><button class="opt" onclick="mc(1,this,false,'Empathize is the stage used to understand experiences and context.','n1')">D. Test</button></div><div id="f1" class="feedback"></div><div class="row"><span class="small">5 points</span><button id="n1" class="btn next" onclick="go(2)">Next →</button></div></section><section class="screen" id="s2"><h2>Question 2</h2><p class="sub">Which stage turns observations into a focused problem or need?</p><div class="options"><button class="opt" onclick="mc(2,this,false,'Define focuses the need and problem using what the team has learned.','n2')">A. Prototype</button><button class="opt" onclick="mc(2,this,true,'Define focuses the need and problem using what the team has learned.','n2')">B. Define</button><button class="opt" onclick="mc(2,this,false,'Define focuses the need and problem using what the team has learned.','n2')">C. Test</button><button class="opt" onclick="mc(2,this,false,'Define focuses the need and problem using what the team has learned.','n2')">D. Ideate</button></div><div id="f2" class="feedback"></div><div class="row"><span class="small">5 points</span><button id="n2" class="btn next" onclick="go(3)">Next →</button></div></section><section class="screen" id="s3"><h2>Question 3</h2><p class="sub">Which stage deliberately generates multiple approaches?</p><div class="options"><button class="opt" onclick="mc(3,this,false,'Ideate is about generating alternatives before choosing one.','n3')">A. Define</button><button class="opt" onclick="mc(3,this,true,'Ideate is about generating alternatives before choosing one.','n3')">B. Ideate</button><button class="opt" onclick="mc(3,this,false,'Ideate is about generating alternatives before choosing one.','n3')">C. Prototype</button><button class="opt" onclick="mc(3,this,false,'Ideate is about generating alternatives before choosing one.','n3')">D. Test</button></div><div id="f3" class="feedback"></div><div class="row"><span class="small">5 points</span><button id="n3" class="btn next" onclick="go(4)">Next →</button></div></section><section class="screen" id="s4"><h2>Question 4</h2><p class="sub">What is the purpose of a prototype?</p><div class="options"><button class="opt" onclick="mc(4,this,false,'A prototype is a learning tool; it makes an idea testable.','n4')">A. To prove the final design is perfect</button><button class="opt" onclick="mc(4,this,true,'A prototype is a learning tool; it makes an idea testable.','n4')">B. To make an idea tangible so the team can learn</button><button class="opt" onclick="mc(4,this,false,'A prototype is a learning tool; it makes an idea testable.','n4')">C. To avoid testing</button><button class="opt" onclick="mc(4,this,false,'A prototype is a learning tool; it makes an idea testable.','n4')">D. To replace user input</button></div><div id="f4" class="feedback"></div><div class="row"><span class="small">5 points</span><button id="n4" class="btn next" onclick="go(5)">Next →</button></div></section><section class="screen" id="s5"><h2>Question 5</h2><p class="sub">What is the purpose of testing?</p><div class="options"><button class="opt" onclick="mc(5,this,false,'Testing helps the team learn what works, what fails, and what should change.','n5')">A. To defend the original idea</button><button class="opt" onclick="mc(5,this,true,'Testing helps the team learn what works, what fails, and what should change.','n5')">B. To collect evidence and learn</button><button class="opt" onclick="mc(5,this,false,'Testing helps the team learn what works, what fails, and what should change.','n5')">C. To skip iteration</button><button class="opt" onclick="mc(5,this,false,'Testing helps the team learn what works, what fails, and what should change.','n5')">D. To guarantee success</button></div><div id="f5" class="feedback"></div><div class="row"><span class="small">5 points</span><button id="n5" class="btn next" onclick="go(6)">Next →</button></div></section><section class="screen" id="s6"><h2>Question 6</h2><p class="sub">Which best describes the five-stage framework?</p><div class="options"><button class="opt" onclick="mc(6,this,false,'The syllabus treats design thinking as an iterative cycle.','n6')">A. A rigid one-way staircase</button><button class="opt" onclick="mc(6,this,true,'The syllabus treats design thinking as an iterative cycle.','n6')">B. An iterative cycle that can loop back</button><button class="opt" onclick="mc(6,this,false,'The syllabus treats design thinking as an iterative cycle.','n6')">C. A technology-selection checklist</button><button class="opt" onclick="mc(6,this,false,'The syllabus treats design thinking as an iterative cycle.','n6')">D. A final reporting format</button></div><div id="f6" class="feedback"></div><div class="row"><span class="small">5 points</span><button id="n6" class="btn next" onclick="go(7)">Next →</button></div></section><section class="screen" id="s7"><h2>Sequence Challenge — 1 to 5</h2><p class="sub">Drag the stages into the numbered boxes. Start at 1. This shows the usual sequence; after Test, the team may loop back.</p>
<div class="dragbank"><div class="drag" draggable="true" data-v="Empathize">Empathize</div><div class="drag" draggable="true" data-v="Define">Define</div><div class="drag" draggable="true" data-v="Ideate">Ideate</div><div class="drag" draggable="true" data-v="Prototype">Prototype</div><div class="drag" draggable="true" data-v="Test">Test</div></div>
<div class="dropgrid"><div class="dropzone" data-p="1"><h3>1</h3></div><div class="dropzone" data-p="2"><h3>2</h3></div><div class="dropzone" data-p="3"><h3>3</h3></div><div class="dropzone" data-p="4"><h3>4</h3></div><div class="dropzone" data-p="5"><h3>5</h3></div></div>
<button class="btn" onclick="checkSeq()">CHECK</button><div id="sf" class="feedback"></div><div class="row"><button id="n7" class="btn next" onclick="go(8)">Finish →</button></div></section>
<section class="screen" id="s8"><div class="hero"><span class="tag">COMPLETE</span><h2>Design thinking is a learning cycle.</h2><div style="font-size:44px;color:var(--cyan)" id="finalScore"></div><p class="sub" id="finalMsg"></p></div></section></div><script>
let score=0,done=0,total=1;
function update(){document.getElementById('score').textContent=score;document.getElementById('bar').style.width=Math.min(100,done/total*100)+'%'}
function go(n){document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));document.getElementById('s'+n).classList.add('active');window.scrollTo({top:0,behavior:'smooth'});update()}
function mc(id,btn,ok,msg,next){let box=btn.parentElement;if(box.dataset.done)return;box.dataset.done=1;box.querySelectorAll('.opt').forEach(b=>b.disabled=true);btn.classList.add(ok?'good':'bad');let f=document.getElementById('f'+id);f.className='feedback show '+(ok?'ok':'no');f.innerHTML=msg;if(ok)score+=5;done++;document.getElementById(next).classList.add('show');update()}
function final(msg){document.getElementById('finalScore').textContent=score;document.getElementById('finalMsg').textContent=msg;document.getElementById('bar').style.width='100%'}
</script>
let selectedDrag=null;
function dragInit(){
  const cards=[...document.querySelectorAll('.drag')];
  const zones=[...document.querySelectorAll('.dropzone')];

  cards.forEach(d=>{
    d.draggable=true;

    d.addEventListener('dragstart',e=>{
      e.dataTransfer.effectAllowed='move';
      e.dataTransfer.setData('text/plain',d.dataset.v);
      d.classList.add('dragging');
    });
    d.addEventListener('dragend',()=>d.classList.remove('dragging'));

    // Touch / pointer support
    d.addEventListener('click',()=>{
      if(selectedDrag===d){
        d.style.outline='';
        selectedDrag=null;
      }else{
        if(selectedDrag) selectedDrag.style.outline='';
        selectedDrag=d;
        d.style.outline='2px solid var(--cyan)';
      }
    });
  });

  zones.forEach(z=>{
    z.addEventListener('dragover',e=>{
      e.preventDefault();
      z.style.borderColor='var(--cyan)';
    });
    z.addEventListener('dragleave',()=>{
      z.style.borderColor='';
    });
    z.addEventListener('drop',e=>{
      e.preventDefault();
      z.style.borderColor='';
      const v=e.dataTransfer.getData('text/plain');
      const d=document.querySelector('.drag[data-v="'+v+'"]');
      if(d && !z.querySelector('.drag')) placeCard(d,z);
    });

    // Click-to-place fallback for preview/touch
    z.addEventListener('click',()=>{
      if(selectedDrag && !z.querySelector('.drag')){
        placeCard(selectedDrag,z);
        selectedDrag.style.outline='';
        selectedDrag=null;
      }
    });
  });
}

function placeCard(card,zone){
  zone.appendChild(card);
  card.style.margin='4px 0';
  card.style.outline='';
}

function checkSeq(){
  const exp=['Empathize','Define','Ideate','Prototype','Test'];
  const a=[...document.querySelectorAll('.dropzone')].map(z=>z.querySelector('.drag')?.dataset.v);
  const f=document.getElementById('sf');

  if(a.some(x=>!x)){
    f.className='feedback show no';
    f.innerHTML='Place all five stages before checking.';
    return;
  }

  if(a.every((v,i)=>v===exp[i])){
    score+=20; done++;
    f.className='feedback show ok';
    f.innerHTML='The usual flow is understand → define → generate → make tangible → learn. The cycle can then return to an earlier stage.';
    document.getElementById('n7').classList.add('show');
    update();
  }else{
    f.className='feedback show no';
    f.innerHTML='The order is not quite right. Start with understanding people, then define the need, generate options, prototype, and test.';
  }
}
dragInit(); total=7; update();
</body></html>
